# Copy to .env.local. Values from Supabase → Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for links in emails, calendar feeds and link previews. Production: https://goodlocallife.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reminders. CRON_SECRET: any long random string; the same value goes in the database:
#   insert into app_secrets (name, value) values ('cron_secret', 'THE-SAME-VALUE');
CRON_SECRET=

# Email. Local: the mail catcher (no user/pass). Production: Resend SMTP
# (SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=your Resend API key).
SMTP_HOST=127.0.0.1
SMTP_PORT=54335
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Good Local Life <reminders@goodlocallife.com>"

# Text messages: OFF until funded (about A$0.08–0.10 per text). Turns on SMS sign-in and text reminders.
NEXT_PUBLIC_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
